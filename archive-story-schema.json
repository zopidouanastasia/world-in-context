{
  "schema_version": "2.0",
  "story_record_schema": {
    "story_id": "string; persistent canonical identifier",
    "canonical_topic": "string",
    "headline": "string; latest working headline",
    "first_seen": "YYYY-MM-DD",
    "last_seen": "YYYY-MM-DD",
    "last_updated": "ISO-8601 datetime or YYYY-MM-DD",
    "status": "NEW | MAJOR_UPDATE | MINOR_UPDATE | CONTINUING | BACKGROUND | DUPLICATE | CLOSED",
