        "summary": "string or null"
      }
    ],
    "last_summary": "string",
    "open_questions": [
      "string"
    ],
    "editorial_notes": [
      "string"
    ]
  },
  "daily_briefing_schema": {
    "date": "YYYY-MM-DD",
