{
  "schema_version": "2.0",
  "briefing_target_cards": 10,
  "human_approval_required": true,
  "publication_without_approval": false,
  "selection_principles": [
    "Material importance",
    "Meaningful Information Delta",
    "Reliable verification",
    "Explanatory value",
    "Relevance to a Greek and European reader",
    "Avoidance of repetition",
    "System-level context where useful"
  ],
  "continuity_statuses": [
    "NEW",
    "MAJOR_UPDATE",
    "MINOR_UPDATE",
    "CONTINUING",
    "BACKGROUND",
    "DUPLICATE",
    "CLOSED"
  ],
  "confidence_states": [
    "CONFIRMED",
    "PROBABLE",
    "UNCERTAIN",
    "CONFLICTED",
    "REJECTED"
  ],
  "candidate_decisions": [
    "KEEP",
    "BORDERLINE",
    "REPLACE",
    "DROP",
    "MORE_RESEARCH"
  ],
  "human_commands": [
    "APPROVE",
    "DROP",
    "REPLACE",
    "MORE_RESEARCH",
    "SHORTER",
    "MORE_CONTEXT"
  ],
  "scores": {
    "Importance": [
      0,
      5
    ],
    "Impact": [
      0,
      5
    ],
    "Novelty": [
      0,
      5
    ],
    "Reliability": [
      0,
      5
    ],
    "ContextValue": [
      0,
      5
    ],
    "GreekEuropeanRelevance": [
      0,
      5
    ]
  },
  "scoring_rule": "Scores are decision support only and must not mechanically determine selection.",
  "card_structure": [
    "what_happened",
    "why_it_matters",
    "what_to_keep",
    "context_if_needed",
    "sources"
  ],
  "fact_analysis_estimate_rule": "FACT, ANALYSIS and ESTIMATE must be explicitly separable in the drafting logic.",
  "source_rule": {
    "preferred_pattern": [
      "one primary or official source",
      "one genuinely independent reliable source",
      "one supplementary source where useful"
    ],
    "wire_duplication_rule": "Syndicated copies of the same wire report are not independent confirmations."
  },
  "qa_requirements": {
    "fact": true,
    "source_links": true,
    "editorial": true,
    "mobile_visual": true,
    "final_card_feedback_cta": true
  },
  "rejection_logging_required": true,
  "archive_check_before_selection": true,
  "daily_delta_blind_spot_rule": {
    "permanent": true,
    "additive_to_master": true,
    "checks_per_calendar_day": [
      "MAIN_DAILY_SOURCE_SWEEP",
      "SAME_DAY_DELTA_CHECK"
    ],
    "main_daily_source_sweep": {
      "required_steps": [
        "continuity_check",
        "full_core_source_sweep",
        "material_claim_cross_check",
        "shortlist_and_editorial_scoring",
        "final_blind_spot_check",
        "propose_final_cards",
        "propose_level_2_analysis"
      ]
    },
    "regional_blind_spot_sweep": {
      "mandatory": true,
      "regions": [
        "Greece",
        "Balkans",
        "Black Sea",
        "Eastern Mediterranean",
        "Turkey",
        "Southeast Europe"
      ],
      "focus": [
        "energy and energy infrastructure",
        "defence and security",
        "critical infrastructure",
        "transport and trade corridors",
        "natural gas and electricity interconnections",
        "geopolitical shifts",
        "economic developments",
        "technology and industrial investment",
        "direct or indirect relevance to Greece"
      ],
      "global_headline_presence_required": false,
      "same_editorial_criteria_as_other_stories": true
    },
    "same_day_delta_check": {
      "target_local_time": "19:00",
      "timezone": "Europe/Athens",
      "baseline": "already selected or published cards of same briefing date",
      "rebuild_briefing_from_scratch": false,
      "sections": [
        "NEW",
        "UPDATE",
        "MISSED / BLIND-SPOT",
        "NO MATERIAL CHANGE",
        "EDITORIAL ACTION"
      ],
      "editorial_actions": [
        "KEEP",
        "UPDATE",
        "ADD",
        "REPLACE",
        "MOVE TO MONITORING"
      ]
    },
    "event_distinction": {
      "NEW_EVENT": "event happened after the initial source sweep",
      "NEW_INFORMATION": "new evidence materially changed understanding of an existing story",
      "MISSED_STORY": "story was already available during the initial briefing window but was not detected"
    },
    "editorial_displacement": {
      "enabled": true,
      "format": "REPLACE CARD X → NEW STORY",
      "reason_required": true
    },
    "quality_improvement_loop": {
      "required_for_missed_blind_spot": true,
      "diagnostics": [
        "why_not_detected",
        "underchecked_category_or_region",
        "source_that_surfaced_story",
        "source_registry_change_needed",
        "search_query_change_needed",
        "failure_stage"
      ]
    },
    "human_approval_before_delta_production": true,
    "delta_may_not_create_html_or_images_without_approval": true
  }
}